{
  "name": "quiz",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": "./src/*/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "pnpm run \"/^lint-.*/\"",
    "lint-typecheck": "tsc --noEmit",
    "lint-eslint": "eslint .",
    "lint-prettier": "prettier --check .",
    "lint-knip": "knip --directory ../.. --workspace features/quiz",
    "clean": "rm -rf node_modules/.cache"
  },
  "devDependencies": {
    "tooling": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "prettier": "tooling/prettier"
}
